\jclisttab\tx720\wrapdefault\aspalpha\aspnum\faauto\ls3\adjustright\rin0\lin720\itap0\pararsid13321389 {\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid13321389\charrsid13321389 De verticale as (Noord-Zuid):}{\rtlch\fcs1 \af31507 \ltrch\fcs0 
\insrsid13321389\charrsid13321389  De }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid13321389\charrsid13321389 Hoofdvaart}{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid13321389\charrsid13321389 
, het centrale afwateringskanaal dat kaarsrecht door de polder loopt.
\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\f31506\kerning2\insrsid13321389\charrsid13321389 \hich\af31506\dbch\af31506\loch\f31506 2.\tab}}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid13321389\charrsid13321389 
