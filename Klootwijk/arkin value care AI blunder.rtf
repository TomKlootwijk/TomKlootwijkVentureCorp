\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \f3\fs20\kerning2\insrsid9708344\charrsid9708344 \loch\af3\dbch\af31506\hich\f3 \'b7\tab}}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 
