{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:equation-world-zero:state",
  "title": "Equation World Zero State",
  "type": "object",
  "required": ["entity_id", "time", "position", "phase", "sheet", "address", "branch", "parity"],
  "properties": {
    "entity_id": {"type": "string"},
    "time": {"type": "number"},
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "phase": {"type": "number", "description": "Phase coordinate in radians or a declared normalized phase domain."},
    "sheet": {"type": "integer", "minimum": 0},
    "address": {"type": "string", "description": "Persistent lineage/provenance key."},
    "branch": {"type": "string"},
    "parity": {"type": "integer", "enum": [0, 1]},
    "state_variables": {"type": "object", "additionalProperties": true},
    "uncertainty": {
      "type": "object",
      "properties": {
        "position_radius": {"type": "number", "minimum": 0},
        "time_radius": {"type": "number", "minimum": 0},
        "phase_radius": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "invariant_tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
