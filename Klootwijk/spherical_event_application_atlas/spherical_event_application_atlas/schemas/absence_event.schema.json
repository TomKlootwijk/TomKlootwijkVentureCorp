{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/spherical-event/absence_event.schema.json",
  "title": "Auditable Absence Event",
  "description": "A negative event that can be emitted only after a valid expectation, complete declared coverage, a closed due interval and no matching compatible event.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "timeValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ],
      "description": "Continuous model time or an ISO 8601 timestamp."
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string"
        },
        "interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "value",
        "method"
      ]
    },
    "reasonCode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ]
    }
  },
  "properties": {
    "absence_event_id": {
      "type": "string"
    },
    "expectation_id": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "relation_id": {
      "type": "string"
    },
    "emitted_at": {
      "$ref": "#/$defs/timeValue"
    },
    "due_interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/timeValue"
      }
    },
    "coverage_complete": {
      "const": true
    },
    "coverage_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "support_valid": {
      "const": true
    },
    "compatibility_valid": {
      "const": true
    },
    "matching_event_count": {
      "const": 0
    },
    "exception_checked": {
      "const": true
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/reasonCode"
          }
        ]
      }
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "predicate_version": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "absence_event_id",
    "expectation_id",
    "entity_id",
    "relation_id",
    "emitted_at",
    "due_interval",
    "coverage_complete",
    "coverage_evidence",
    "support_valid",
    "compatibility_valid",
    "matching_event_count",
    "exception_checked",
    "reason_codes",
    "confidence",
    "predicate_version",
    "schema_version"
  ]
}