\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \f3\fs20\kerning2\insrsid556457\charrsid556457 \loch\af3\dbch\af31506\hich\f3 \'b7\tab}}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid556457\charrsid556457 The Physics:}{\rtlch\fcs1 
\af31507 \ltrch\fcs0 \insrsid556457\charrsid556457  This grip acts as the bridge between the physics of the string and the pen.
\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af31507 \ltrch\fcs0 \f2\fs20\kerning2\insrsid556457\charrsid556457 \hich\af2\dbch\af31506\loch\f2 o\tab}}\pard \ltrpar\ql \fi-360\li1440\ri0\sa160\sl278\slmult1\widctlpar
